<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".GarmentApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.GarmentShop">
        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false"
            android:label="@string/title_checkout" />
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false"
            android:label="@string/title_cart" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:label="@string/title_register" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:label="@string/title_login" />
        <activity
            android:name=".ui.product.ProductDetailActivity"
            android:exported="false"
            android:label="@string/title_product_detail" />
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
